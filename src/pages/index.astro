---
import Layout from "../layouts/Layout.astro";
import GameCard from "../components/GameCard.astro";
import PageHero from "../components/PageHero.astro";
import EmptyState from "../components/EmptyState.astro";
import { getDatabase } from "../lib/db";
import { getAllCategories, getAllPublishers, getFilteredGames } from "../lib/games";

export const prerender = true;

const db = getDatabase();
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
const games = await getFilteredGames(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-8 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        <form
          method="get"
          action="/"
          class="rounded-xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg"
          data-testid="game-filters"
        >
          <fieldset>
            <legend class="mb-3 text-sm font-semibold text-slate-100">Filter games</legend>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
              <div>
                <span id="category-filter-label" class="mb-2 block text-sm text-slate-300">Categories</span>
                <div
                  class="flex flex-wrap gap-3"
                  data-testid="category-filters"
                  role="group"
                  aria-labelledby="category-filter-label"
                >
                  {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.name}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`category-filter-${category.id}`}
                      />
                      {category.name}
                    </label>
                  ))}
                </div>
              </div>

              <label class="flex flex-col gap-2 text-sm text-slate-300">
                Publisher
                <select
                  name="publisher"
                  class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.name}>{publisher.name}</option>)}
                </select>
              </label>

              <button
                type="submit"
                class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="apply-filters"
              >
                Apply filters
              </button>
            </div>
          </fieldset>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <p class="mb-4 hidden text-sm text-slate-400" data-testid="filter-summary" aria-live="polite"></p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <p class="hidden py-8 text-center text-slate-400" data-testid="filtered-empty" role="status">
            No games match the selected filters.
          </p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-testid='game-filters']");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-testid='game-card']")];
  const summary = document.querySelector<HTMLElement>("[data-testid='filter-summary']");
  const emptyState = document.querySelector<HTMLElement>("[data-testid='filtered-empty']");

  if (form && summary && emptyState) {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = params.getAll("category");
    const selectedPublisher = params.get("publisher") ?? "";

    for (const checkbox of form.querySelectorAll<HTMLInputElement>("input[name='category']")) {
      checkbox.checked = selectedCategories.includes(checkbox.value);
    }

    const publisherSelect = form.querySelector<HTMLSelectElement>("select[name='publisher']");
    if (publisherSelect) {
      publisherSelect.value = selectedPublisher;
    }

    const visibleCards = cards.filter((card) => {
      const categoryMatches =
        selectedCategories.length === 0 ||
        selectedCategories.includes(card.dataset.gameCategory ?? "");
      const publisherMatches =
        selectedPublisher === "" || card.dataset.gamePublisher === selectedPublisher;
      const isVisible = categoryMatches && publisherMatches;
      card.hidden = !isVisible;
      return isVisible;
    });

    const hasFilters = selectedCategories.length > 0 || selectedPublisher !== "";
    summary.textContent = `Showing ${visibleCards.length} ${
      visibleCards.length === 1 ? "game" : "games"
    } matching your filters.`;
    summary.classList.toggle("hidden", !hasFilters);
    emptyState.classList.toggle("hidden", !hasFilters || visibleCards.length > 0);
  }
</script>
